# GoPlant Frontend Environment Configuration
# API Base URL must include /api/v1 and not end with a trailing slash

# Option 1: Expo Web / Local Development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Option 2: Android Emulator (maps to host localhost)
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Option 3: Physical Device on LAN (replace with machine IP)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8080/api/v1

# Request Timeout (milliseconds, default: 15000)
EXPO_PUBLIC_API_TIMEOUT=15000
